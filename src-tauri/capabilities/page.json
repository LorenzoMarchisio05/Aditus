{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "page",
  "description": "Untrusted web pages. May only send page_ping.",
  "windows": ["main"],
  "webviews": ["tab-*"],
  "remote": { "urls": ["http://*", "https://*", "http://*:*", "https://*:*"] },
  "local": true,
  "permissions": ["allow-page-ping"]
}
