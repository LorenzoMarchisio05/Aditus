{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "internal",
  "description": "Browser pages (settings, history, downloads) in tabs. Local app origin only; remote pages never match.",
  "windows": ["main", "w*"],
  "webviews": [
    "tab-*"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-new-tab",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-address",
    "allow-back",
    "allow-forward",
    "allow-reload",
    "allow-set-layout",
    "allow-assign-mapping",
    "allow-skip-prompt",
    "allow-undo-swap",
    "allow-dismiss-toast",
    "allow-save-settings",
    "allow-add-profile",
    "allow-delete-profile",
    "allow-delete-mapping",
    "allow-toggle-allowlist",
    "allow-pin-tab",
    "allow-group-tab",
    "allow-find",
    "allow-find-clear",
    "allow-open-devtools",
    "allow-history-search",
    "allow-history-clear",
    "allow-downloads-list",
    "allow-show-palette",
    "allow-hide-palette",
    "allow-reveal-path",
    "allow-reorder-tab",
    "allow-show-panel",
    "allow-hide-panel",
    "allow-switch-profile",
    "allow-adblock-info",
    "allow-check-update"
  ]
}