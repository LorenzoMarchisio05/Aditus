{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "Browser chrome (sidebar, top bar, palette). Full app command access.",
  "windows": ["main", "w*"],
  "webviews": ["ui", "ui-*", "palette", "palette-*", "panel", "panel-*"],
  "permissions": [
    "core:default", "core:window:allow-start-dragging",
    "allow-get-state",
    "allow-new-tab",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-address",
    "allow-back",
    "allow-forward",
    "allow-reload",
    "allow-set-layout",
    "allow-assign-mapping",
    "allow-skip-prompt",
    "allow-undo-swap",
    "allow-dismiss-toast",
    "allow-save-settings",
    "allow-add-profile",
    "allow-delete-profile",
    "allow-delete-mapping",
    "allow-toggle-allowlist",
    "allow-pin-tab",
    "allow-group-tab",
    "allow-find",
    "allow-find-clear",
    "allow-open-devtools",
    "allow-history-search",
    "allow-history-clear",
    "allow-downloads-list",
    "allow-show-palette",
    "allow-hide-palette",
    "allow-reveal-path",
    "allow-reorder-tab",
    "allow-show-panel",
    "allow-hide-panel",
    "allow-switch-profile", "allow-profile-menu",
    "allow-adblock-info",
    "allow-check-update",
    "allow-default-browser-settings"
  ]
}